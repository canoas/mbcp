# Copy to .env and fill in. Never commit .env.

# API base URL (no trailing slash).
#   QA mock (static canned responses): https://apiqa.millenniumbcp.pt/b2bInquiring/v1-mock
#   Real environment: ask Millennium bcp (api.integration@millenniumbcp.pt)
URL=https://apiqa.millenniumbcp.pt/b2bInquiring/v1-mock

# API Management subscription key, sent as the Ocp-Apim-Subscription-Key header.
API_KEY=your-subscription-key

# Optional: comma-separated account numbers (BBAN), used when none are passed on the command line.
ACCOUNTS=1372742
